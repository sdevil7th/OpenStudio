thirdparty/basic-pitch/NOTICE text eol=lf
thirdparty/ffmpeg/COPYING.GPLv3 text eol=lf
thirdparty/ffmpeg/PROVENANCE.json text eol=lf
thirdparty/signalsmith/LICENSE.txt text eol=lf
thirdparty/signalsmith/signalsmith-linear/LICENSE.txt text eol=lf
