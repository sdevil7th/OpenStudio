+    constexpr std::array<float, v2LateLineCount>
+        outputLeftSigns {
+            1.0f, -1.0f, 1.0f, -1.0f,
+            1.0f, -1.0f, 1.0f, -1.0f,
+            -1.0f, 1.0f, -1.0f, 1.0f,
+            -1.0f, 1.0f, -1.0f, 1.0f
+        };
+    constexpr std::array<float, v2LateLineCount>
+        outputRightSigns {
+            1.0f, 1.0f, -1.0f, -1.0f,
+            -1.0f, -1.0f, 1.0f, 1.0f,
+            1.0f, 1.0f, -1.0f, -1.0f,
+            -1.0f, -1.0f, 1.0f, 1.0f
+        };
+    constexpr std::array<float, v2LateLineCount>
+        shimmerProjection0 {
+            1.0f, 1.0f, 1.0f, 1.0f,
+            -1.0f, -1.0f, -1.0f, -1.0f,
+            1.0f, 1.0f, 1.0f, 1.0f,
+            -1.0f, -1.0f, -1.0f, -1.0f
+        };
+    constexpr std::array<float, v2LateLineCount>
+        shimmerProjection1 {
+            1.0f, 1.0f, -1.0f, -1.0f,
+            1.0f, 1.0f, -1.0f, -1.0f,
+            1.0f, 1.0f, -1.0f, -1.0f,
+            1.0f, 1.0f, -1.0f, -1.0f
+        };
+    constexpr std::array<float, v2LateLineCount>
+        shimmerInjection0 {
+            1.0f, -1.0f, -1.0f, 1.0f,
+            1.0f, -1.0f, -1.0f, 1.0f,
+            -1.0f, 1.0f, 1.0f, -1.0f,
+            -1.0f, 1.0f, 1.0f, -1.0f
+        };
+    constexpr std::array<float, v2LateLineCount>
+        shimmerInjection1 {
+            1.0f, -1.0f, 1.0f, -1.0f,
+            -1.0f, 1.0f, -1.0f, 1.0f,
+            -1.0f, 1.0f, -1.0f, 1.0f,
+            1.0f, -1.0f, 1.0f, -1.0f
