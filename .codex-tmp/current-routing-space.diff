+                    .fetch_add(
+                        1,
+                        std::memory_order_relaxed);
+                v2EmergencyBoundHitCount
+                    .fetch_add(
+                        1,
+                        std::memory_order_relaxed);
+                writeValue =
+                    std::isfinite(writeValue)
+                        ? juce::jlimit(
+                              -8.0f,
+                              8.0f,
+                              writeValue)
+                        : 0.0f;
+            }
+            v2LatePool[
+                static_cast<size_t>(
+                    v2LateOffsets[lineIndex]
+                    + v2LateWriteIndices[
+                        lineIndex])] =
+                writeValue;
+            v2LateWriteIndices[
+                lineIndex] =
+                v2LateWriteIndices[lineIndex] + 1
