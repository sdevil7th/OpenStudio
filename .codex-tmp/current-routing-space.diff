+void AudioEngine::retireRealtimeSnapshotOwner(
+    std::shared_ptr<const void> owner)
+{
+    if (owner != nullptr)
+        retiredRealtimeSnapshotOwners.push_back(
+            std::move(owner));
+}
+
+void AudioEngine::reclaimRetiredRealtimeSnapshotOwners()
+{
+    std::vector<std::shared_ptr<const void>> reclaim;
+    {
+        const juce::ScopedLock retirementGuard(
+            realtimeSnapshotRetirementLock);
+        if (realtimeSnapshotAudioReaders.load(
+                std::memory_order_seq_cst) == 0)
+        {
+            reclaim.swap(retiredRealtimeSnapshotOwners);
+        }
+    }
+    // Destructors may release processors and other sizeable graph state. Keep
+    // that work outside the retirement lock and, crucially, off the callback.
+}
+
+void AudioEngine::publishRealtimeTrackSnapshot(
+    std::shared_ptr<const RealtimeTrackSnapshot> snapshot)
+{
+    if (snapshot == nullptr)
+        snapshot =
+            std::make_shared<const RealtimeTrackSnapshot>();
+
+    // Only snapshots retired by an earlier publication are eligible here. A
+    // callback that starts after this check can still observe the current raw
+    // pointer, whose owner remains current until it is retired below.
+    reclaimRetiredRealtimeSnapshotOwners();
+    const juce::ScopedLock retirementGuard(
+        realtimeSnapshotRetirementLock);
+    const auto previous = std::atomic_load_explicit(
+        &realtimeTrackSnapshot,
+        std::memory_order_acquire);
+    if (previous != nullptr
+        && previous.get() != snapshot.get())
+    {
+        retireRealtimeSnapshotOwner(
+            std::static_pointer_cast<const void>(
+                previous));
+    }
+
+    // Establish the owning publication before exposing its non-owning realtime
+    // pointer. The replaced owner deliberately survives at least one later
+    // publication; the callback reader epoch then proves it is safe to reclaim.
+    std::atomic_store_explicit(
+        &realtimeTrackSnapshot,
+        snapshot,
+        std::memory_order_release);
+    realtimeTrackSnapshotForAudio.store(
+        snapshot.get(), std::memory_order_seq_cst);
+}
+
