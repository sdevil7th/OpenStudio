+            if (channel == 0)
+            {
+                return 0.112f
+                        * std::sin(
+                            juce::MathConstants<float>::twoPi
+                            * 229.0f * time)
+                    + 0.031f
+                        * std::sin(
+                            juce::MathConstants<float>::twoPi
+                            * 683.0f * time + 0.19f);
