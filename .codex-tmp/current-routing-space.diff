+    constexpr std::array<float, 4>
+        modulationRatesHz {
+            0.071f, 0.103f, 0.137f, 0.181f
+        };
+    constexpr std::array<float, v2LateLineCount>
+        preMatrixSigns {
+            1.0f, -1.0f, 1.0f, 1.0f,
+            -1.0f, 1.0f, -1.0f, -1.0f,
+            1.0f, 1.0f, -1.0f, 1.0f,
+            -1.0f, -1.0f, 1.0f, -1.0f
+        };
+    constexpr std::array<int, v2LateLineCount>
+        matrixPermutation {
+            0, 5, 10, 15,
+            7, 2, 13, 8,
+            3, 14, 1, 12,
+            11, 6, 9, 4
+        };
+    constexpr std::array<float, v2LateLineCount>
+        postMatrixSigns {
+            1.0f, 1.0f, -1.0f, 1.0f,
+            -1.0f, -1.0f, 1.0f, -1.0f,
+            1.0f, -1.0f, 1.0f, 1.0f,
+            -1.0f, 1.0f, -1.0f, -1.0f
+        };
+    constexpr std::array<float, v2LateLineCount>
+        inputMidSigns {
+            1.0f, 1.0f, 1.0f, 1.0f,
+            1.0f, 1.0f, 1.0f, 1.0f,
+            -1.0f, -1.0f, -1.0f, -1.0f,
+            -1.0f, -1.0f, -1.0f, -1.0f
+        };
+    constexpr std::array<float, v2LateLineCount>
+        inputSideSigns {
+            1.0f, -1.0f, 1.0f, -1.0f,
+            1.0f, -1.0f, 1.0f, -1.0f,
+            1.0f, -1.0f, 1.0f, -1.0f,
+            1.0f, -1.0f, 1.0f, -1.0f
