+static RealtimeSafetyFixtureResult runPlaybackBoundedStreamingFixture()
+{
+    constexpr double sourceSampleRate = 48000.0;
+    constexpr double resampledRate = 44100.0;
+    constexpr int sourceSamples = 4096;
+    constexpr int outputSamples = 1536;
+    const auto fixtureId = juce::Uuid().toString();
+    const auto fixtureFile = juce::File::getSpecialLocation(
+        juce::File::tempDirectory).getChildFile(
+            "openstudio_playback_decoded_fixture_"
+            + fixtureId + ".wav");
+    const auto oversizedFile = juce::File::getSpecialLocation(
+        juce::File::tempDirectory).getChildFile(
+            "openstudio_playback_streaming_fixture_"
+            + fixtureId + ".wav");
+
+    juce::AudioBuffer<float> source(2, sourceSamples);
+    for (int sample = 0; sample < sourceSamples; ++sample)
+    {
+        const float position = static_cast<float>(sample);
+        source.setSample(
+            0,
+            sample,
+            0.31f * std::sin(position * 0.013f)
+                + 0.11f * std::cos(position * 0.0037f));
+        source.setSample(
+            1,
+            sample,
+            -0.27f * std::cos(position * 0.0091f)
+                + 0.07f * std::sin(position * 0.021f));
+    }
+
+    const bool fixtureWritten = writeBufferToWavFile(
+        source, sourceSamples, sourceSampleRate, fixtureFile);
+
+    const auto writeOversizedSparseWav =
+        [&oversizedFile, sourceSampleRate] ()
+    {
+        oversizedFile.deleteFile();
+        std::unique_ptr<juce::FileOutputStream> stream(
+            oversizedFile.createOutputStream());
+        if (stream == nullptr)
+            return false;
+
+        constexpr int channels = 2;
+        constexpr int bytesPerSample = 4;
+        constexpr int blockAlign =
+            channels * bytesPerSample;
+        constexpr int dataBytes =
+            static_cast<int>(
+                PlaybackEngine::
+                    MAX_FULLY_DECODED_SOURCE_BYTES)
+            + blockAlign;
+        const int byteRate =
+            static_cast<int>(sourceSampleRate)
+            * blockAlign;
+
+        bool ok = stream->write("RIFF", 4)
+            && stream->writeInt(36 + dataBytes)
+            && stream->write("WAVE", 4)
+            && stream->write("fmt ", 4)
+            && stream->writeInt(16)
+            && stream->writeShort(
+                static_cast<short>(3))
+            && stream->writeShort(
+                static_cast<short>(channels))
+            && stream->writeInt(
+                static_cast<int>(sourceSampleRate))
+            && stream->writeInt(byteRate)
+            && stream->writeShort(
+                static_cast<short>(blockAlign))
+            && stream->writeShort(
+                static_cast<short>(32))
+            && stream->write("data", 4)
+            && stream->writeInt(dataBytes)
+            && stream->setPosition(
+                static_cast<juce::int64>(44)
+                + dataBytes - 1)
+            && stream->writeByte(0);
+        stream->flush();
+        stream.reset();
+        return ok
+            && oversizedFile.getSize()
+                == static_cast<juce::int64>(44)
+                    + dataBytes;
+    };
+
+    bool decodedPathSelected = false;
+    bool exactPartitionPass = false;
+    bool resampledPartitionPass = false;
+    bool exactSamplePass = false;
+    int decodedSources = 0;
+    juce::int64 decodedBytes = 0;
+    int decodedCacheMisses = -1;
+    double exactPartitionMaxDiff =
+        std::numeric_limits<double>::infinity();
+    double resampledPartitionMaxDiff =
+        std::numeric_limits<double>::infinity();
+    double exactSampleMaxDiff =
+        std::numeric_limits<double>::infinity();
+
+    if (fixtureWritten)
+    {
+        auto playbackProbe =
+            std::make_unique<PlaybackEngine>();
+        playbackProbe->addClip(
+            fixtureFile,
+            0.0,
+            static_cast<double>(sourceSamples)
+                / sourceSampleRate,
+            "decoded-fixture-track",
+            0.0,
+            0.0,
+            0.0,
+            0.0,
+            "decoded-fixture-clip");
+
+        const auto renderPartitioned =
+            [&] (double targetRate,
+                 bool useUnevenPartitions)
+        {
+            juce::AudioBuffer<float> rendered(
+                2, outputSamples);
+            rendered.clear();
+            constexpr std::array<int, 10>
+                unevenPartitions {
+                    16, 7, 31, 16, 5,
+                    64, 23, 16, 127, 3
+                };
+            int outputPosition = 0;
+            int partitionIndex = 0;
+            while (outputPosition < outputSamples)
+            {
+                const int requested =
+                    useUnevenPartitions
+                        ? unevenPartitions[
+                            static_cast<size_t>(
+                                partitionIndex
+                                % static_cast<int>(
+                                    unevenPartitions
+                                        .size()))]
+                        : outputSamples;
+                const int samplesThisBlock =
+                    juce::jmin(
+                        requested,
+                        outputSamples
+                            - outputPosition);
+                juce::AudioBuffer<float> block(
+                    2, samplesThisBlock);
+                block.clear();
+                playbackProbe->fillTrackBuffer(
+                    "decoded-fixture-track",
+                    block,
+                    static_cast<double>(
+                        outputPosition)
+                        / targetRate,
+                    samplesThisBlock,
+                    targetRate);
+                for (int channel = 0;
+                     channel < 2;
+                     ++channel)
+                {
+                    rendered.copyFrom(
+                        channel,
+                        outputPosition,
+                        block,
+                        channel,
+                        0,
+                        samplesThisBlock);
+                }
+                outputPosition += samplesThisBlock;
+                ++partitionIndex;
+            }
+            return rendered;
+        };
+
+        const auto exactSingle =
+            renderPartitioned(sourceSampleRate, false);
+        const auto exactUneven =
+            renderPartitioned(sourceSampleRate, true);
+        const auto resampledSingle =
+            renderPartitioned(resampledRate, false);
+        const auto resampledUneven =
+            renderPartitioned(resampledRate, true);
+
+        exactPartitionMaxDiff = 0.0;
+        resampledPartitionMaxDiff = 0.0;
+        exactSampleMaxDiff = 0.0;
+        for (int channel = 0; channel < 2; ++channel)
+        {
+            for (int sample = 0;
+                 sample < outputSamples;
+                 ++sample)
+            {
+                exactPartitionMaxDiff = juce::jmax(
+                    exactPartitionMaxDiff,
+                    static_cast<double>(std::abs(
+                        exactSingle.getSample(
+                            channel, sample)
+                        - exactUneven.getSample(
+                            channel, sample))));
+                resampledPartitionMaxDiff = juce::jmax(
+                    resampledPartitionMaxDiff,
+                    static_cast<double>(std::abs(
+                        resampledSingle.getSample(
+                            channel, sample)
+                        - resampledUneven.getSample(
+                            channel, sample))));
+                exactSampleMaxDiff = juce::jmax(
+                    exactSampleMaxDiff,
+                    static_cast<double>(std::abs(
+                        exactSingle.getSample(
+                            channel, sample)
+                        - source.getSample(
+                            channel, sample))));
+            }
+        }
+
+        decodedSources =
+            playbackProbe->getFullyDecodedSourceCount();
+        decodedBytes =
+            playbackProbe->getFullyDecodedSourceBytes();
+        decodedCacheMisses =
+            playbackProbe->getAudioDataCacheMissCount();
+        decodedPathSelected =
+            decodedSources == 1
+            && decodedBytes
+                == static_cast<juce::int64>(
+                    sourceSamples * 2
+                    * static_cast<int>(sizeof(float)))
+            && playbackProbe
+                    ->getAudioDataCachedFileCount()
+                == 0
+            && playbackProbe
+                    ->getStreamingReadAheadCapacityBytes()
+                == 0
+            && decodedCacheMisses == 0;
+        exactPartitionPass =
+            exactPartitionMaxDiff <= 1.0e-6;
+        resampledPartitionPass =
+            resampledPartitionMaxDiff <= 1.0e-6;
+        exactSamplePass =
+            exactSampleMaxDiff <= 1.0e-6;
+    }
+
+    const bool oversizedWritten =
+        writeOversizedSparseWav();
+    bool oversizedUsesStreaming = false;
+    int oversizedStreamingReaders = 0;
+    int oversizedDecodedSources = -1;
+    juce::int64 oversizedStreamingBytes = 0;
+    if (oversizedWritten)
+    {
+        auto oversizedProbe =
+            std::make_unique<PlaybackEngine>();
+        oversizedProbe->addClip(
+            oversizedFile,
+            0.0,
+            0.25,
+            "oversized-fixture-track",
+            0.0,
+            0.0,
+            0.0,
+            0.0,
+            "oversized-fixture-clip");
+        oversizedStreamingReaders =
+            oversizedProbe
+                ->getAudioDataCachedFileCount();
+        oversizedDecodedSources =
+            oversizedProbe
+                ->getFullyDecodedSourceCount();
+        oversizedStreamingBytes =
+            oversizedProbe
+                ->getStreamingReadAheadCapacityBytes();
+        oversizedUsesStreaming =
+            oversizedStreamingReaders == 1
+            && oversizedDecodedSources == 0
+            && oversizedStreamingBytes > 0
+            && oversizedStreamingBytes
+                <= 512LL * 1024LL;
+    }
+
+    const auto continuityRegression =
+        PlaybackEngine::
+            runStreamingContinuityRegression();
+    const auto outerLockContinuityRegression =
+        PlaybackEngine::
+            runOuterLockContinuityRegression();
+
+    fixtureFile.deleteFile();
+    oversizedFile.deleteFile();
+
+    RealtimeSafetyFixtureResult result;
+    result.pass =
+        decodedPathSelected
+        && exactPartitionPass
+        && resampledPartitionPass
+        && exactSamplePass
+        && oversizedUsesStreaming
+        && continuityRegression.passed
+        && outerLockContinuityRegression.passed;
+    result.detail =
+        "decodedSources="
+        + juce::String(decodedSources)
+        + ", decodedBytes="
+        + juce::String(decodedBytes)
+        + ", decodedCacheMisses="
+        + juce::String(decodedCacheMisses)
+        + ", exactPartitionMaxDiff="
+        + juce::String(
+            exactPartitionMaxDiff, 9)
+        + ", resampledPartitionMaxDiff="
+        + juce::String(
+            resampledPartitionMaxDiff, 9)
+        + ", exactSampleMaxDiff="
+        + juce::String(
+            exactSampleMaxDiff, 9)
+        + ", oversizedStreamingReaders="
+        + juce::String(
+            oversizedStreamingReaders)
+        + ", oversizedDecodedSources="
+        + juce::String(
+            oversizedDecodedSources)
+        + ", oversizedReadAheadBytes="
+        + juce::String(
+            oversizedStreamingBytes)
+        + ", continuityEntryStep="
+        + juce::String(
+            continuityRegression
+                .concealmentEntryStep,
+            9)
+        + ", continuityRecoveryMaxStep="
+        + juce::String(
+            continuityRegression
+                .recoveryMaximumStep,
+            9)
+        + ", continuityPartitionMaxDiff="
+        + juce::String(
+            continuityRegression
+                .partitionMaximumDifference,
+            9)
+        + ", continuityRecoveredSample="
+        + juce::String(
+            continuityRegression
+                .recoveredSample,
+            9)
+        + ", continuityFadeToZeroFinalSample="
+        + juce::String(
+            continuityRegression
+                .fadeToZeroFinalSample,
+            9)
+        + ", outerLockTryMisses="
+        + juce::String(
+            outerLockContinuityRegression
+                .tryLockMisses)
+        + ", outerLockConcealmentEvents="
+        + juce::String(
+            outerLockContinuityRegression
+                .concealmentEvents)
+        + ", outerLockRecoveryEvents="
+        + juce::String(
+            outerLockContinuityRegression
+                .recoveryEvents)
+        + ", outerLockConcealmentEntryStep="
+        + juce::String(
+            outerLockContinuityRegression
+                .concealmentEntryStep,
+            9)
+        + ", outerLockRecoveryEntryStep="
+        + juce::String(
+            outerLockContinuityRegression
+                .recoveryEntryStep,
+            9)
+        + ", outerLockRecoveredSample="
+        + juce::String(
+            outerLockContinuityRegression
+                .recoveredSample,
+            9);
+    return result;
+}
