+                (shimmerInput0
+                 - v2ShimmerPreLowPassState[0])
+                * shimmerPreLowPassCoefficient;
+            v2ShimmerPreLowPassState[1] +=
+                (shimmerInput1
+                 - v2ShimmerPreLowPassState[1])
