+        auto& targetLowCutR =
+            v3WetFilterUsesAlternate
+                ? wetLowCutR
+                : v3WetLowCutAlternateR;
+        auto& targetHighCutL =
+            v3WetFilterUsesAlternate
+                ? wetHighCutL
+                : v3WetHighCutAlternateL;
+        auto& targetHighCutR =
+            v3WetFilterUsesAlternate
+                ? wetHighCutR
