+std::uint64_t packTunerInputRoute(
+    std::uint32_t generation,
+    int startChannel,
+    int channelCount) noexcept
+{
+    const auto packedStart =
+        startChannel < 0
+            ? static_cast<std::uint16_t>(0xffffu)
+            : static_cast<std::uint16_t>(
+                juce::jlimit(0, 0xfffe, startChannel));
+    const auto packedCount =
+        static_cast<std::uint16_t>(
+            juce::jlimit(0, 0xffff, channelCount));
+    return
+        (static_cast<std::uint64_t>(generation) << 32)
+        | (static_cast<std::uint64_t>(packedStart) << 16)
+        | static_cast<std::uint64_t>(packedCount);
+}
+
+std::uint32_t tunerRouteGeneration(
+    std::uint64_t packedRoute) noexcept
+{
+    return static_cast<std::uint32_t>(
+        packedRoute >> 32);
+}
+
+int tunerRouteStartChannel(
+    std::uint64_t packedRoute) noexcept
+{
+    const auto packedStart =
+        static_cast<std::uint16_t>(
+            (packedRoute >> 16) & 0xffffu);
+    return packedStart == 0xffffu
+        ? -1
+        : static_cast<int>(packedStart);
+}
+
+int tunerRouteChannelCount(
+    std::uint64_t packedRoute) noexcept
+{
+    return static_cast<int>(
+        static_cast<std::uint16_t>(
