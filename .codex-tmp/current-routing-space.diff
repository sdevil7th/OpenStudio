+void AudioEngine::resolveRealtimeRoutingBuffers(
+    std::vector<RealtimeTrackEntry>& trackSnapshot,
+    const RealtimeRoutingBufferMap& sidechainBuffers,
+    const RealtimeRoutingBufferMap& sendBuffers)
+{
+    for (auto& entry : trackSnapshot)
+    {
+        entry.sidechainOutputBuffer.reset();
+        entry.sendAccumBuffer.reset();
+        entry.sidechainSourceBuffers.clear();
+        entry.hasIncomingSends = false;
+        for (auto& resolvedSend : entry.sends)
+            resolvedSend.destinationBuffer.reset();
+    }
+
+    const auto findSnapshotEntry =
+        [&trackSnapshot] (const juce::String& trackId)
+            -> RealtimeTrackEntry*
+        {
+            const auto entryIt = std::find_if(
+                trackSnapshot.begin(),
+                trackSnapshot.end(),
+                [&trackId] (const RealtimeTrackEntry& entry)
+                {
+                    return entry.id == trackId;
+                });
+            return entryIt != trackSnapshot.end()
+                ? &*entryIt
+                : nullptr;
+        };
+
+    // Resolve sidechain buffers only for tracks that are actually named as a
+    // source in this immutable routing snapshot. Unrouted tracks retain null
+    // output buffers and therefore incur no callback clear or output copy.
+    for (auto& destinationEntry : trackSnapshot)
+    {
+        destinationEntry.sidechainSourceBuffers.reserve(
+            destinationEntry.sidechainSourceIds.size());
+        for (const auto& sourceId :
+             destinationEntry.sidechainSourceIds)
+        {
+            std::shared_ptr<juce::AudioBuffer<float>>
+                sourceBuffer;
+            if (auto* sourceEntry = findSnapshotEntry(sourceId))
+            {
+                const auto sourceBufferIt =
+                    sidechainBuffers.find(sourceId);
+                if (sourceBufferIt
+                    != sidechainBuffers.end())
+                {
+                    sourceBuffer = sourceBufferIt->second;
+                    sourceEntry->sidechainOutputBuffer =
+                        sourceBuffer;
