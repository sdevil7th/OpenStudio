+                (stage & 1) == 0
+                    ? 1.0f
+                    : -1.0f;
+            const float stageCoefficient =
+                baseDiffusionCoefficient
+                * stageScale
+                * stageSign;
+            const float stageL =
+                processDiffusionLine(
+                    stage * 2,
+                    diffuseL,
+                    stageCoefficient);
+            const float stageR =
+                processDiffusionLine(
+                    stage * 2 + 1,
+                    diffuseR,
+                    -stageCoefficient);
+            if ((stage & 1) == 0)
+            {
+                diffuseL =
+                    stageL * 0.9238795f
+                    + stageR * 0.3826834f;
+                diffuseR =
+                    stageR * 0.9238795f
+                    - stageL * 0.3826834f;
+            }
+            else
+            {
+                diffuseL =
+                    (stageL + stageR)
+                    * inverseSqrtTwo;
+                diffuseR =
+                    (stageL - stageR)
+                    * inverseSqrtTwo;
