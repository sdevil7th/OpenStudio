+        const auto deterministicNoise = [] (
+            int sample,
+            juce::uint32 salt) noexcept
+        {
+            auto bits = static_cast<juce::uint32>(sample) + salt;
+            bits ^= bits >> 16;
+            bits *= 0x7feb352dU;
+            bits ^= bits >> 15;
+            bits *= 0x846ca68bU;
+            bits ^= bits >> 16;
+            return static_cast<float>(bits & 0x00ffffffU)
+                    / 8388607.5f
+                - 1.0f;
+        };
+
+        const auto sampleInput = [&] (
+            SourceKind source,
+            int channel,
+            int absoluteSample)
+        {
+            const float time = static_cast<float>(
+                static_cast<double>(absoluteSample) / sampleRate);
+            const float nearSilence =
+                0.000020f
+                    * deterministicNoise(
+                        absoluteSample,
+                        channel == 0
+                            ? 0x13579bdfU
+                            : 0x2468ace0U)
+                + 0.000005f
+                    * std::sin(
+                        juce::MathConstants<float>::twoPi
+                        * (channel == 0 ? 997.0f : 1231.0f)
+                        * time);
+            if (source == SourceKind::nearSilence)
+                return nearSilence;
+
+            const bool burst =
+                (absoluteSample >= firstBurstStart
+                 && absoluteSample < firstBurstEnd)
+                || (absoluteSample >= secondBurstStart
+                    && absoluteSample < secondBurstEnd);
+            if (source == SourceKind::leftOnlyBurst
+                && channel == 1)
+            {
+                return 0.0f;
+            }
+            if (source == SourceKind::burstIdleBurst
+                && channel == 1)
