+            lateOutputL[sample];
+        float diffuseR =
+            lateOutputR != nullptr
+                ? lateOutputR[sample]
+                : diffuseL;
+        const float currentDiffusion =
+            smoothedV2Diffusion.getNextValue();
+        const float baseDiffusionCoefficient =
+            juce::jlimit(
+                0.38f,
+                0.72f,
+                0.40f
+                    + currentDiffusion
+                        * 0.36f
+                    + (character == 0
+                           ? -0.05f
+                           : (character == 2
+                                  ? 0.025f
+                                  : 0.0f)));
