+        "OpenStudio NAM Rack").getChildFile(
+            presetName + ".ospreset");
+    if (migration.targetFile.existsAsFile()
+        && sourceFile.getFullPathName()
+               != migration.targetFile.getFullPathName())
+    {
+        // Stable-first current storage is authoritative. A same-name legacy
+        // file remains shadowed and must never overwrite the .ospreset.
+        if (! migration.targetFile.loadFileAsData(migration.payload))
+            return false;
+        bool targetChanged = false;
+        if (! S13NAMRack::migratePresetStateToCurrent(
+                migration.payload, targetChanged))
+        {
+            return false;
+        }
+        migration.sourceFile = migration.targetFile;
+        migration.rewriteRequired = targetChanged;
+        if (! persistMigration)
+            return true;
+
+        const auto sourceMetadata =
+            getBuiltInPresetMetadataFile(sourceFile);
+        const auto targetMetadata =
+            getBuiltInPresetMetadataFile(migration.targetFile);
+        bool wroteNewMetadata = false;
+        if (sourceMetadata.existsAsFile()
+            && ! targetMetadata.existsAsFile())
+        {
+            juce::MemoryBlock metadataPayload;
+            if (! sourceMetadata.loadFileAsData(metadataPayload)
+                || ! writeBuiltInPresetPayloadAtomically(
