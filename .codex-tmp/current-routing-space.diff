+        0.0,
+        kRealtimeFXTailMaximumSeconds - kRealtimeFXTailSafetySeconds,
+        reportedTailSeconds);
+    const double budgetSeconds = juce::jlimit(
+        kRealtimeFXTailQuietWindowSeconds,
+        kRealtimeFXTailMaximumSeconds,
