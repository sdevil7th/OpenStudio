+void AudioEngine::applyRoutedDeviceChannelPolicy(
+    juce::AudioDeviceManager::AudioDeviceSetup& setup,
+    int minimumInputChannels,
+    int minimumOutputChannels) const
+{
+    constexpr int maximumRoutableChannels = 128;
+    int requiredInputChannels =
+        juce::jlimit(0, maximumRoutableChannels, minimumInputChannels);
+    int requiredOutputChannels =
+        juce::jlimit(0, maximumRoutableChannels, minimumOutputChannels);
+
+    // JUCE packs active hardware channels into callback arrays. Keep the masks
+    // contiguous from channel zero through the highest route in use so existing
+    // track channel indices retain their physical-device meaning.
+    if (requiredInputChannels > 0)
+    {
+        for (const auto& [trackId, track] : trackMap)
+        {
+            juce::ignoreUnused(trackId);
+            if (track == nullptr)
+                continue;
+
+            const int startChannel =
+                juce::jmax(0, track->getInputStartChannel());
+            const int channelCount =
+                juce::jmax(1, track->getInputChannelCount());
+            requiredInputChannels = juce::jmax(
+                requiredInputChannels,
+                juce::jlimit(
+                    0,
+                    maximumRoutableChannels,
+                    startChannel + channelCount));
+        }
+    }
+
+    if (requiredOutputChannels > 0)
+    {
+        for (const auto& [trackId, track] : trackMap)
+        {
+            juce::ignoreUnused(trackId);
+            if (track == nullptr)
+                continue;
+
+            const int startChannel =
+                juce::jmax(0, track->getOutputStartChannel());
+            const int channelCount =
+                juce::jmax(1, track->getOutputChannelCount());
+            requiredOutputChannels = juce::jmax(
+                requiredOutputChannels,
+                juce::jlimit(
+                    0,
+                    maximumRoutableChannels,
+                    startChannel + channelCount));
+        }
+    }
+
+    setup.useDefaultInputChannels = false;
+    setup.inputChannels.clear();
+    if (requiredInputChannels > 0)
+        setup.inputChannels.setRange(0, requiredInputChannels, true);
+
+    setup.useDefaultOutputChannels = false;
+    setup.outputChannels.clear();
+    if (requiredOutputChannels > 0)
+        setup.outputChannels.setRange(0, requiredOutputChannels, true);
+}
+
+void AudioEngine::refreshRoutedDeviceChannels()
+{
+    if (deviceManager.getCurrentAudioDevice() == nullptr)
+        return;
+
+    juce::AudioDeviceManager::AudioDeviceSetup currentSetup;
+    deviceManager.getAudioDeviceSetup(currentSetup);
+    auto routedSetup = currentSetup;
+    const int minimumInputChannels =
+        isMicrophonePermissionGrantedForInput() ? 2 : 0;
+    applyRoutedDeviceChannelPolicy(
+        routedSetup,
+        minimumInputChannels,
+        2);
+
+    if (routedSetup.inputChannels == currentSetup.inputChannels
+        && routedSetup.outputChannels == currentSetup.outputChannels
+        && routedSetup.useDefaultInputChannels
+            == currentSetup.useDefaultInputChannels
+        && routedSetup.useDefaultOutputChannels
+            == currentSetup.useDefaultOutputChannels)
+    {
+        return;
+    }
+
+    const auto error =
+        deviceManager.setAudioDeviceSetup(routedSetup, true);
+    if (error.isNotEmpty())
+    {
+        juce::Logger::writeToLog(
+            "AudioEngine: Failed to activate routed low-latency channels: "
+            + error);
+    }
+}
