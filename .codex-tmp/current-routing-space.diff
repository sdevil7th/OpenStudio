+            {
+                return false;
+            }
+            wroteNewMetadata = true;
+        }
+        if (targetChanged
+            && ! writeBuiltInPresetPayloadAtomically(
+                migration.targetFile, migration.payload))
+        {
+            if (wroteNewMetadata)
+                (void) targetMetadata.deleteFile();
+            return false;
+        }
+        return true;
+    }
+    migration.rewriteRequired = stateChanged
+        || sourceFile.getFullPathName()
+               != migration.targetFile.getFullPathName();
+    if (! persistMigration || ! migration.rewriteRequired)
+        return true;
+
