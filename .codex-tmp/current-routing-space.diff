+        }
+        if (preCurrentEffects)
+        {
+            if (! hasCompressorAttack)
+            {
+                setCurrentProperty(
+                    "compressorAttackMs",
+                    migrateLegacyCompressorAttackMs(
+                        legacyCompressorDetail));
