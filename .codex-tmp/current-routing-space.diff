+
+        const float currentMovement =
+            smoothedV2Movement.getNextValue();
+        const float modDepthSamples =
+            characterModDepthMs
+            * (0.15f
+               + currentMovement * 0.85f)
+            * 0.001f
+            * static_cast<float>(
+                cachedSampleRate);
+        std::array<float, v2LateLineCount>
+            tankRead {};
+        for (int line = 0;
+             line < v2LateLineCount;
+             ++line)
+        {
+            float modulationSamples = 0.0f;
+            for (size_t modulator = 0;
+                 modulator
+                     < modulatedLines.size();
+                 ++modulator)
+            {
+                if (line
+                    != modulatedLines[modulator])
+                    continue;
+                modulationSamples =
+                    lookupModulationSine(
+                        v2ModPhase[
+                            static_cast<size_t>(
+                                line)])
+                    * modDepthSamples;
+                v2ModPhase[
+                    static_cast<size_t>(
+                        line)] +=
+                    juce::MathConstants<float>::twoPi
+                    * modulationRatesHz[modulator]
+                    / static_cast<float>(
+                        juce::jmax(
+                            1.0,
+                            cachedSampleRate));
