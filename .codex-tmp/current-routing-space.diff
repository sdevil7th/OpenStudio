+bool AudioEngine::setNAMTunerActive(
+    const juce::String& trackId,
+    bool active,
+    const juce::String& subscriberId)
+{
+    const juce::String effectiveSubscriberId =
+        subscriberId.isNotEmpty()
+            ? subscriberId
+            : "legacy:" + trackId;
+
+    if (active && trackId.isNotEmpty())
+    {
+        const auto trackIt = trackMap.find(trackId);
+        if (trackIt == trackMap.end()
+            || trackIt->second == nullptr
+            || trackIt->second->getTrackType() != TrackType::Audio)
+            return false;
+    }
+
+    if (active)
+    {
+        tunerSubscriberOrder.erase(
+            std::remove(
+                tunerSubscriberOrder.begin(),
+                tunerSubscriberOrder.end(),
+                effectiveSubscriberId),
+            tunerSubscriberOrder.end());
+        tunerSubscribers[effectiveSubscriberId] = trackId;
+        tunerSubscriberOrder.push_back(effectiveSubscriberId);
+    }
+    else
+    {
+        const auto subscriberIt =
+            tunerSubscribers.find(effectiveSubscriberId);
+        if (subscriberIt != tunerSubscribers.end()
+            && subscriberIt->second == trackId)
+        {
+            tunerSubscribers.erase(subscriberIt);
+            tunerSubscriberOrder.erase(
+                std::remove(
+                    tunerSubscriberOrder.begin(),
+                    tunerSubscriberOrder.end(),
+                    effectiveSubscriberId),
+                tunerSubscriberOrder.end());
+        }
+        else
+        {
+            return false;
+        }
+    }
+
+    refreshNAMTunerRoute();
+    return true;
+}
