+void AudioEngine::rolloverLoopRecordings(double newTakeStartSeconds)
+{
+    // NativeBridge, transport actions, and ARA transport handlers marshal this
+    // control operation onto JUCE's message thread. File creation/finalization
+    // must never migrate back into audioDeviceIOCallback().
+    jassert(juce::MessageManager::getInstance()->isThisTheMessageThread());
+    ++loopTakeCounter;
+
+    std::vector<AudioRecorder::CompletedRecording> completedAudioTakes;
+    std::vector<juce::String> armedMidiTrackIds;
+    armedMidiTrackIds.reserve(trackMap.size());
+    for (const auto& [trackId, track] : trackMap)
+    {
+        if (track == nullptr || !track->getRecordArmed())
+            continue;
+        const auto trackType = track->getTrackType();
+        if (trackType == TrackType::MIDI || trackType == TrackType::Instrument)
+            armedMidiTrackIds.push_back(trackId);
+    }
+    auto completedMidiTakes = midiRecorder.rolloverRecordings(
+        armedMidiTrackIds,
+        currentSampleRate,
+        newTakeStartSeconds,
+        projectAudioFolder,
+        tempo);
+
+    const auto timestamp = juce::Time::getCurrentTime().toMilliseconds();
+    for (const auto& [trackId, track] : trackMap)
+    {
+        if (track == nullptr || ! track->getRecordArmed())
+            continue;
+
+        const auto trackType = track->getTrackType();
+        if (trackType == TrackType::MIDI || trackType == TrackType::Instrument)
+            continue;
+
+        const auto filename = "Track_" + trackId + "_Take_" + juce::String(timestamp)
+            + "_L" + juce::String(loopTakeCounter) + ".wav";
+        const auto outputFile = projectAudioFolder.getChildFile(filename);
+        AudioRecorder::CompletedRecording previousTake;
+        if (audioRecorder.rolloverRecording(trackId,
+                                            outputFile,
+                                            currentSampleRate,
+                                            track->getInputChannelCount(),
+                                            newTakeStartSeconds,
+                                            previousTake))
+        {
+            if (previousTake.file.existsAsFile())
+                completedAudioTakes.push_back(std::move(previousTake));
+        }
+    }
+
+    for (const auto& take : completedAudioTakes)
+    {
+        const auto filePath = take.file.getFullPathName();
+        peakCache.generateAsync(take.file, [this, filePath]
+        {
+            if (onPeaksReady)
+                onPeaksReady(filePath);
+        });
+    }
+    lastCompletedClips.insert(lastCompletedClips.end(),
+                              std::make_move_iterator(completedAudioTakes.begin()),
+                              std::make_move_iterator(completedAudioTakes.end()));
+    lastCompletedMIDIClips.insert(lastCompletedMIDIClips.end(),
+                                  std::make_move_iterator(completedMidiTakes.begin()),
+                                  std::make_move_iterator(completedMidiTakes.end()));
+}
