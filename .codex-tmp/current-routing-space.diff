+static RealtimeSafetyFixtureResult runRecorderControlThreadFinalizeFixture()
+{
+    constexpr double fixtureSampleRate = 48000.0;
+    constexpr int fixtureBlockSize = 256;
+    const auto fixtureFile = juce::File::getSpecialLocation(
+        juce::File::tempDirectory).getChildFile(
+            "openstudio_recorder_handoff_fixture_" + juce::Uuid().toString() + ".wav");
+    auto recorderProbe = std::make_unique<AudioRecorder>();
+    juce::AudioBuffer<float> input(2, fixtureBlockSize);
+    input.clear();
+    input.setSample(0, 0, 0.5f);
+    input.setSample(1, 0, -0.5f);
+
+    const bool started = recorderProbe->startRecording(
+        "recorder-fixture-track", fixtureFile, fixtureSampleRate, 2);
+    if (started)
+    {
+        recorderProbe->setRecordingStartTime("recorder-fixture-track", 1.25);
+        recorderProbe->writeBlock(
+            "recorder-fixture-track", input, fixtureBlockSize, 1.2);
+    }
+    const auto completed = recorderProbe->stopAllRecordings(fixtureSampleRate);
+
+    juce::AudioFormatManager readerFormats;
+    readerFormats.registerBasicFormats();
+    std::unique_ptr<juce::AudioFormatReader> reader(
+        readerFormats.createReaderFor(fixtureFile));
+    const bool readable = reader != nullptr;
+    const auto recordedLength = reader != nullptr ? reader->lengthInSamples : 0;
+    const bool recorderPass = started
+        && completed.size() == 1
+        && std::abs(completed.front().startTime - 1.2) < 1.0e-9
+        && std::abs(completed.front().duration
+                    - static_cast<double>(fixtureBlockSize) / fixtureSampleRate) < 1.0e-9
+        && readable
+        && recordedLength == fixtureBlockSize;
+    reader.reset();
+    fixtureFile.deleteFile();
+
+    RealtimeSafetyFixtureResult result;
+    result.pass = recorderPass;
+    result.detail = "started=" + juce::String(started ? "true" : "false")
+        + ", completed=" + juce::String(static_cast<int>(completed.size()))
+        + ", readable=" + juce::String(readable ? "true" : "false");
+    return result;
+}
