+
+    auto readV2Line =
+        [&] (int line,
+             float delaySamplesToRead) noexcept
+        {
+            const size_t lineIndex =
+                static_cast<size_t>(line);
+            const int capacity =
+                v2LateCapacities[lineIndex];
+            delaySamplesToRead =
+                juce::jlimit(
+                    1.0f,
+                    static_cast<float>(
+                        capacity - 3),
+                    delaySamplesToRead);
+            if (static_cast<float>(
+                    v2ValidLateHistorySamples)
+                < std::ceil(
+                    delaySamplesToRead))
+                return 0.0f;
+
+            float readPosition =
+                static_cast<float>(
+                    v2LateWriteIndices[lineIndex])
+                - delaySamplesToRead;
+            while (readPosition < 0.0f)
+                readPosition +=
+                    static_cast<float>(
+                        capacity);
+            const int indexA =
+                static_cast<int>(
+                    readPosition);
+            const int indexB =
+                indexA + 1 < capacity
+                    ? indexA + 1
+                    : 0;
+            const float fraction =
+                readPosition
+                - static_cast<float>(
+                    indexA);
+            const int offset =
+                v2LateOffsets[lineIndex];
+            const float first =
+                v2LatePool[
+                    static_cast<size_t>(
+                        offset + indexA)];
+            const float second =
+                v2LatePool[
+                    static_cast<size_t>(
+                        offset + indexB)];
+            return first
+                + (second - first)
+                    * fraction;
+        };
+
+    auto processDiffusionLine =
+        [&] (int line,
+             float input,
+             float coefficient) noexcept
+        {
+            const size_t lineIndex =
+                static_cast<size_t>(line);
+            const int capacity =
+                v2DiffusionCapacities[
+                    lineIndex];
+            const int writeIndex =
+                v2DiffusionWriteIndices[
+                    lineIndex];
+            const size_t poolIndex =
+                static_cast<size_t>(
+                    v2DiffusionOffsets[lineIndex]
+                    + writeIndex);
+            const float delayed =
+                v2DiffusionPool[poolIndex];
+            const float output =
+                delayed
+                - coefficient * input;
+            v2DiffusionPool[poolIndex] =
+                input
+                + coefficient * output;
+            v2DiffusionWriteIndices[
+                lineIndex] =
+                writeIndex + 1 < capacity
+                    ? writeIndex + 1
+                    : 0;
+            return output;
+        };
+
+    auto* lateOutputL =
+        buffer.getWritePointer(0);
+    auto* lateOutputR =
+        numChannels >= 2
+            ? buffer.getWritePointer(1)
+            : nullptr;
+    constexpr float inverseSqrtTwo =
+        0.7071067811865475f;
+    constexpr float inverseSqrtSixteen =
+        0.25f;
+    const float characterModDepthMs =
+        character == 0
+            ? 0.10f
+            : (character == 1
+                   ? 0.22f
+                   : 0.34f);
+    const float characterInputGain =
+        character == 0
+            ? 0.25f
+            : (character == 1
+                   ? 0.22f
+                   : 0.19f);
+
+    for (int sample = 0;
+         sample < numSamples;
+         ++sample)
+    {
