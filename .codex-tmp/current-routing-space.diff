+            {
+                values->removeProperty(propertyName);
+                changed = true;
+            }
+        }
+        if (storedVersion != S13NAMRack::currentNAMEffectsDspVersion
+            && std::abs(originalVolume) <= 1.0e-6)
+        {
+            setValue("precisionDriveVolumeDb", 9.0);
+        }
